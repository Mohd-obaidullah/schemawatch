# ==============================================================================
# schemawatch Environment Configuration Template
# Copy to .env and customize. Never commit .env with real credentials.
# ==============================================================================

# Database connection (SQLite default for local, PostgreSQL for production)
SCHEMAWATCH_DATABASE_URL=sqlite:///schemawatch.db
# SCHEMAWATCH_DATABASE_URL=postgresql://schemawatch:schemawatch_password@localhost:5432/schemawatch

# Redis for distributed cooldown deduplication (optional, in-memory fallback if omitted)
# SCHEMAWATCH_REDIS_URL=redis://localhost:6379/0

# API Authentication Token (required unless DEV_MODE=true)
SCHEMAWATCH_API_TOKEN=your-random-secure-token-here

# Development Mode (disables mandatory auth token check; off by default; logs warning when true)
SCHEMAWATCH_DEV_MODE=false

# Watchdog Sampling & Cooldown Settings
SCHEMAWATCH_LEARN_SAMPLES=10
SCHEMAWATCH_SAMPLE_RATE=1.0
SCHEMAWATCH_COOLDOWN_SECONDS=300
SCHEMAWATCH_MIN_ALERT_SEVERITY=warning

# Alert Channels (optional webhook endpoints)
# SCHEMAWATCH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# SCHEMAWATCH_ALERT_WEBHOOK_URL=https://example.com/webhooks/schemawatch

# CORS Allowed Origins (comma-separated, empty by default)
SCHEMAWATCH_CORS_ORIGINS=[]
